generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL_POOLED")
  directUrl = env("DATABASE_URL")
}

// ==========================================
// 1. Core Identity & User Management
// ==========================================

enum Role {
  SUPER_ADMIN
  ADMIN
  TEACHER
  STUDENT
  PARENT
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum Gender {
  MALE
  FEMALE
}

// The school administration's accounts only (SUPER_ADMIN & ADMIN).
// Teachers' and students' accounts live in their own tables (teachers / students).
model User {
  id                  String     @id @default(uuid())
  nationalId          String?    @unique // الرقم القومي (14 رقم)
  email               String?    @unique // إيميل المسؤول
  fullName            String     @default("")
  name                String?
  password            String // Bcrypt Hashed Password
  role                Role       @default(ADMIN)
  status              UserStatus @default(ACTIVE)
  forcePasswordChange Boolean    @default(false)
  phone               String?
  jobTitle            String? // المسمى الوظيفي للمسؤول (مثال: وكيل شؤون الطلاب)

  // صلاحيات المسؤول الفرعي:
  permissions String[] @default([])

  // What the administration did (a teacher's own actions are on the teacher)
  recordedAttendances        Attendance[]           @relation("AttendanceRecorder")
  recordedGrades             Grade[]                @relation("GradeRecorder")
  announcedExams             Exam[]                 @relation("ExamAnnouncer")
  authoredAnnouncements      Announcement[]         @relation("AnnouncementAuthor")
  announcementReads          AnnouncementRead[]
  recordedTeacherAttendances TeacherAttendance[]    @relation("TeacherAttendanceRecorder")
  closedAttendanceDays       TeacherAttendanceDay[] @relation("TeacherAttendanceDayCloser")
  createdHolidays            SchoolHoliday[]        @relation("SchoolHolidayCreator")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([nationalId])
  @@map("users")
}

// ==========================================
// 2. Students Management
// ==========================================

model Student {
  id              String   @id @default(cuid())
  studentCode     String   @unique
  fullNameArabic  String
  fullNameEnglish String?
  nationalId      String?  @unique
  gender          Gender   @default(MALE)
  dateOfBirth     String?
  classId         String?
  guardianName    String?
  guardianPhone   String?
  address         String?
  gradeLevel      String?
  enrollmentStatus String?  @default("منتظم")
  isActive        Boolean  @default(true)

  // Sign-in account: national ID + student code the first time, then the student's own password
  password            String? // Bcrypt hash (never returned: omitted by default, see config/database.js)
  role                Role       @default(STUDENT)
  status              UserStatus @default(ACTIVE)
  forcePasswordChange Boolean    @default(true)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  class             Class?             @relation(fields: [classId], references: [id], onDelete: SetNull)
  attendances       Attendance[]
  grades            Grade[]
  announcementReads AnnouncementRead[]
  honorEntries      HonorRoll[]
  assignmentSubmissions AssignmentSubmission[]

  @@index([classId])
  @@index([gradeLevel])
  @@map("students")
}

// ==========================================
// 3. Teachers Management
// ==========================================

enum TeacherEmploymentStatus {
  ON_DUTY // على رأس العمل
  ON_LEAVE // إجازة اعتيادية
  SECONDED // منتدب
}

model Teacher {
  id               String                  @id @default(cuid())
  teacherCode      String                  @unique
  fullNameArabic   String
  fullNameEnglish  String?
  nationalId       String?                 @unique
  specialization   String
  jobTitle         String? // المسمى الوظيفي (مثال: معلم أول رياضيات)
  // Subjects the teacher teaches, by their Arabic name (e.g. "اللغة العربية")
  teachingSubjects String[]                @default([])
  // Which classes each subject is taught to: [{ "subject": "اللغة العربية", "classes": ["1/1", "2/3"] }]
  teachingAssignments Json                 @default("[]")
  employmentStatus TeacherEmploymentStatus @default(ON_DUTY)
  email            String?
  phone            String?
  hireDate         String?
  isActive         Boolean                 @default(true)

  // Sign-in account for the teachers portal (national ID + password; the first sign-in asks for a new one)
  password            String? // Bcrypt hash (never returned: omitted by default, see config/database.js)
  role                Role       @default(TEACHER)
  status              UserStatus @default(ACTIVE)
  forcePasswordChange Boolean    @default(true)

  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  supervisedClasses Class[]             @relation("ClassTeacherSupervisor")
  subjects          Subject[]           @relation("TeacherSubjects")
  classes           Class[]             @relation("TeacherClasses")
  timetableEntries  Timetable[]
  timetablePeriods  TimetablePeriod[]
  attendanceRecords TeacherAttendance[]
  curricula         Curriculum[]
  assignments       Assignment[]

  // What the teacher did
  recordedAttendances   Attendance[]       @relation("AttendanceTeacherRecorder")
  recordedGrades        Grade[]            @relation("GradeTeacherRecorder")
  announcedExams        Exam[]             @relation("ExamTeacherAnnouncer")
  materials             Material[]
  authoredAnnouncements Announcement[]     @relation("AnnouncementTeacherAuthor")
  announcementReads     AnnouncementRead[]
  honorEntries          HonorRoll[]

  @@map("teachers")
}

// ==========================================
// 4. Classrooms Management (e.g. 1/A, 1/B)
// ==========================================

model Class {
  id                String   @id @default(cuid())
  name              String   @unique // e.g. "1/A", "1/B"
  displayNameArabic String?
  gradeLevel        String // e.g. "1st Preparatory"
  roomNumber        String?
  capacity          Int      @default(40)
  classTeacherId    String?
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  classTeacher     Teacher?       @relation("ClassTeacherSupervisor", fields: [classTeacherId], references: [id], onDelete: SetNull)
  assignedTeachers Teacher[]      @relation("TeacherClasses")
  students         Student[]
  timetableEntries Timetable[]
  timetablePeriods TimetablePeriod[]

  materials        Material[]     @relation("MaterialClasses")
  attendances      Attendance[]
  exams            Exam[]
  announcements    Announcement[]
  assignments      Assignment[]

  @@map("classes")
}

// ==========================================
// 5. Subjects Management
// ==========================================

model Subject {
  id          String   @id @default(cuid())
  code        String   @unique // e.g. "MTH-101", "SCI-101"
  nameArabic  String   @unique // one of the school's subjects (src/shared/constants/school-subjects.js)
  nameEnglish String?
  gradeLevel  String
  maxMarks    Float    @default(100)
  passMarks   Float    @default(50)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  teachers         Teacher[]   @relation("TeacherSubjects")
  timetableEntries Timetable[]

  exams            Exam[]
  grades           Grade[]

  @@map("subjects")
}

// ==========================================
// 6. Timetable Management
// ==========================================

enum DayOfWeek {
  SUNDAY
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
}

model Timetable {
  id           String    @id @default(cuid())
  dayOfWeek    DayOfWeek
  periodNumber Int
  startTime    String // e.g. "08:00"
  endTime      String // e.g. "08:45"
  classId      String
  subjectId    String
  teacherId    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  class   Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher Teacher? @relation(fields: [teacherId], references: [id], onDelete: SetNull)

  @@unique([classId, dayOfWeek, periodNumber])
  @@index([classId])
  @@index([teacherId])
  @@index([subjectId])
  @@map("timetable")
}

model TimetablePeriod {
  id          String   @id @default(uuid())
  
  // الترم الدراسي (مثال: "2026-2027-T1")
  termId      String   @map("term_id")
  
  // اليوم الدراسي: 0 = الأحد, 1 = الإثنين, 2 = الثلاثاء, 3 = الأربعاء, 4 = الخميس
  dayOfWeek   Int      @map("day_of_week") // 0 to 4
  
  // رقم الحصة: من 1 إلى 7
  period      Int      // 1 to 7
  
  // المعلم المسؤول
  teacherId   String   @map("teacher_id")
  teacher     Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  
  // الفصل الدراسي
  classId     String   @map("class_id")
  class       Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  
  // المادة الدراسية (مثال: "اللغة العربية", "الرياضيات")
  subject     String
  
  // القاعة / المعمل (اختياري)
  room        String?  // مثال: "101", "معمل العلوم"

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // ==========================================
  // القيود الحاسمة لمنع التعارضات (Unique Indexes)
  // ==========================================

  // 1. يمنع وجود حصتين لنفس الفصل في نفس اليوم والحصة لنفس الترم
  @@unique([termId, classId, dayOfWeek, period], name: "unique_class_period_slot")

  // 2. يمنع وجود حصتين لنفس المعلم في نفس اليوم والحصة لنفس الترم
  @@unique([termId, teacherId, dayOfWeek, period], name: "unique_teacher_period_slot")

  @@index([termId, teacherId])
  @@index([termId, classId])
  @@map("timetable_periods")
}

// ==========================================
// 7. Lesson materials (المواد والملفات التعليمية)
// ==========================================

// What a teacher publishes to their classes: files and / or a link (a YouTube or Drive video...).
// Their students see it as soon as it's saved.
model Material {
  id          String   @id @default(cuid())
  teacherId   String
  // Arabic subject name, as in Teacher.teachingSubjects (e.g. "الرياضيات")
  subject     String
  title       String
  description String   @default("")
  link        String?
  publishedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  teacher Teacher        @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  classes Class[]        @relation("MaterialClasses")
  files   MaterialFile[]

  @@index([teacherId, publishedAt])
  @@index([publishedAt])
  @@map("materials")
}

model MaterialFile {
  id         String   @id @default(cuid())
  materialId String
  fileName   String
  fileSize   Int
  fileType   String?
  // Where the file is kept, relative to the uploads folder
  fileKey    String
  uploadedAt DateTime @default(now())

  material Material @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@index([materialId, uploadedAt])
  @@map("material_files")
}

// ==========================================
// 8. Attendance Management
// ==========================================

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

model Attendance {
  id           String           @id @default(cuid())
  date         String // YYYY-MM-DD
  studentId    String
  classId      String
  status       AttendanceStatus @default(PRESENT)
  remarks      String?
  recordedById String? // an admin (users)
  recordedByTeacherId String? // or a teacher
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  student           Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class             Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  recordedBy        User?    @relation("AttendanceRecorder", fields: [recordedById], references: [id], onDelete: SetNull)
  recordedByTeacher Teacher? @relation("AttendanceTeacherRecorder", fields: [recordedByTeacherId], references: [id], onDelete: SetNull)

  @@unique([studentId, date])
  @@index([classId])
  @@index([date])
  @@index([studentId])
  @@map("attendances")
}

// ==========================================
// 9. Exams & Marks (Grades) Management
// ==========================================

enum ExamType {
  QUIZ
  MIDTERM
  FINAL
  MONTHLY
}

model Exam {
  id              String   @id @default(cuid())
  title           String
  type            ExamType @default(MIDTERM)
  subjectId       String
  classId         String
  examDate        DateTime
  durationMinutes Int      @default(60)
  maxScore        Float    @default(100)
  passScore       Float    @default(50)
  room            String?
  announcedById   String? // an admin (users)
  announcedByTeacherId String? // or a teacher
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  subject            Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  class              Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  announcedBy        User?    @relation("ExamAnnouncer", fields: [announcedById], references: [id], onDelete: SetNull)
  announcedByTeacher Teacher? @relation("ExamTeacherAnnouncer", fields: [announcedByTeacherId], references: [id], onDelete: SetNull)
  grades      Grade[]

  @@index([classId])
  @@index([subjectId])
  @@index([examDate])
  @@map("exams")
}

model Grade {
  id           String   @id @default(cuid())
  studentId    String
  examId       String
  subjectId    String
  score        Float
  maxScore     Float    @default(100)
  percentage   Float
  gradeLetter  String? // A+, A, B, C, D, F
  remarks      String?
  recordedById String? // an admin (users)
  recordedByTeacherId String? // or a teacher
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  student           Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  exam              Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  subject           Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  recordedBy        User?    @relation("GradeRecorder", fields: [recordedById], references: [id], onDelete: SetNull)
  recordedByTeacher Teacher? @relation("GradeTeacherRecorder", fields: [recordedByTeacherId], references: [id], onDelete: SetNull)

  @@unique([studentId, examId])
  @@index([studentId])
  @@index([examId])
  @@index([subjectId])
  @@map("grades")
}

// ==========================================
// 10. Announcements & School Events
// ==========================================

enum AnnouncementType {
  SCHOOL_WIDE
  CLASS_NOTE
}

enum TargetAudience {
  ALL
  TEACHERS
  STUDENTS
  PARENTS
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Announcement {
  id             String           @id @default(cuid())
  title          String
  content        String
  category       String           @default("إداري")
  audiences      String[]         @default(["TEACHER", "STUDENT", "PARENT"])
  authorName     String?          @default("إدارة المدرسة") @map("author_name")
  expiresAt      String?          @map("expires_at") // YYYY-MM-DD
  pinned         Boolean          @default(false)
  attachmentUrl  String?          @map("attachment_url")
  attachmentName String?          @map("attachment_name")
  type           AnnouncementType @default(SCHOOL_WIDE)
  targetAudience TargetAudience   @default(ALL)
  priority       Priority         @default(MEDIUM)
  classId        String?
  authorId       String? // an admin (users)
  authorTeacherId String? // or a teacher
  authorRole     String?
  publishDate    String? // YYYY-MM-DD
  isActive       Boolean          @default(true)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  class         Class?   @relation(fields: [classId], references: [id], onDelete: SetNull)
  author        User?    @relation("AnnouncementAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  teacherAuthor Teacher? @relation("AnnouncementTeacherAuthor", fields: [authorTeacherId], references: [id], onDelete: SetNull)
  reads         AnnouncementRead[]

  @@map("announcements")
}

// Who read an announcement: exactly one of an admin (users), a teacher or a student
model AnnouncementRead {
  id             String       @id @default(cuid())
  announcementId String       @map("announcement_id")
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  userId         String?      @map("user_id")
  user           User?        @relation(fields: [userId], references: [id], onDelete: Cascade)
  teacherId      String?      @map("teacher_id")
  teacher        Teacher?     @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  studentId      String?      @map("student_id")
  student        Student?     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  readAt         DateTime     @default(now()) @map("read_at")

  @@unique([announcementId, userId], name: "unique_announcement_user_read")
  @@unique([announcementId, teacherId], name: "unique_announcement_teacher_read")
  @@unique([announcementId, studentId], name: "unique_announcement_student_read")
  @@index([userId])
  @@index([teacherId])
  @@index([studentId])
  @@index([announcementId])
  @@map("announcement_reads")
}

// ==========================================
// 11. Teachers Attendance Book (دفتر حضور وغياب المعلمين)
// ==========================================

enum TeacherAttendanceStatus {
  PRESENT
  LATE
  ABSENT
  CASUAL_LEAVE
  SICK_LEAVE
  MISSION
  NOT_RECORDED // Filled in when a day is closed without a status for the teacher
}

// One row per teacher per school day. The teacher's name is kept on the row,
// so the archive stays readable even after the teacher is removed.
model TeacherAttendance {
  id             String                  @id @default(cuid())
  date           String // YYYY-MM-DD
  teacherId      String?
  teacherName    String
  // Normalized name (no hamza / taa marbuta variants) for alphabetical ordering
  teacherSortKey String
  specialization String                  @default("")
  status         TeacherAttendanceStatus
  arrivalTime    String? // HH:mm
  departureTime  String? // HH:mm
  note           String?
  recordedById   String?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  teacher    Teacher? @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  recordedBy User?    @relation("TeacherAttendanceRecorder", fields: [recordedById], references: [id], onDelete: SetNull)

  @@unique([teacherId, date])
  @@index([date, teacherSortKey])
  @@index([teacherId])
  @@map("teacher_attendances")
}

// A closed (approved) day can no longer be edited, unless the super admin reopens it.
// A row with isClosed = false is a past day opened by hand (reopened, or filled in late):
// it waits for a manual approval instead of being closed automatically.
model TeacherAttendanceDay {
  date       String    @id // YYYY-MM-DD
  isClosed   Boolean   @default(true)
  closedAt   DateTime? @default(now())
  closedById String?
  // true when the system closed it after the day ended
  autoClosed Boolean   @default(false)

  closedBy User? @relation("TeacherAttendanceDayCloser", fields: [closedById], references: [id], onDelete: SetNull)

  @@map("teacher_attendance_days")
}

// Official days off besides the weekly Friday & Saturday (a single day or a range)
model SchoolHoliday {
  id          String   @id @default(cuid())
  startDate   String // YYYY-MM-DD
  endDate     String // YYYY-MM-DD (same as startDate for one day)
  reason      String
  createdById String?
  createdAt   DateTime @default(now())

  createdBy User? @relation("SchoolHolidayCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([startDate, endDate])
  @@map("school_holidays")
}

// ==========================================
// 12. Curricula (المناهج والمواد الدراسية)
// ==========================================
// Each teacher uploads the ministry curriculum of the subjects they teach (textbook, plan,
// sample exams... as files or links) and writes its plan & objectives week by week.
// Students see the curricula of their own class, without the teacher-only files and the plan.

enum CurriculumFileKind {
  BOOK
  PLAN
  EXAMS
  GUIDE
  OTHER
}

model Curriculum {
  id           String   @id @default(cuid())
  teacherId    String
  // Arabic subject name, as in Teacher.teachingSubjects (e.g. "الرياضيات")
  subject      String
  // "G1" | "G2" | "G3"
  gradeId      String
  // The teacher's classes in that grade that follow it, e.g. ["3/2", "3/3"]
  sections     String[]
  description  String   @default("")
  // The teacher's own plan document (optional, besides the plan written week by week)
  planFileName String?
  planFileSize Int?
  planFileType String?
  planFileKey  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  teacher   Teacher              @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  files     CurriculumFile[]
  planWeeks CurriculumPlanWeek[]

  // One curriculum per subject & grade for the same teacher
  @@unique([teacherId, subject, gradeId])
  @@index([teacherId, updatedAt])
  @@index([updatedAt])
  // A student's class: WHERE sections @> ARRAY['3/2']
  @@index([sections], type: Gin)
  @@map("curricula")
}

model CurriculumFile {
  id           String             @id @default(cuid())
  curriculumId String
  kind         CurriculumFileKind
  title        String
  // false = the teacher's own reference (e.g. the teacher's guide), hidden from students
  forStudents  Boolean            @default(true)
  // A link (the ministry's site, Drive...) or an uploaded file - one of the two
  link         String?
  fileName     String?
  fileSize     Int?
  fileType     String?
  // Where the file is kept, relative to the uploads folder
  fileKey      String?
  uploadedAt   DateTime           @default(now())

  curriculum Curriculum @relation(fields: [curriculumId], references: [id], onDelete: Cascade)

  @@index([curriculumId, uploadedAt])
  @@index([curriculumId, kind, uploadedAt])
  @@map("curriculum_files")
}

model CurriculumPlanWeek {
  id           String   @id @default(cuid())
  curriculumId String
  // Week of the term, 1, 2, 3...
  week         Int
  topic        String
  objectives   String[] @default([])

  curriculum Curriculum @relation(fields: [curriculumId], references: [id], onDelete: Cascade)

  @@unique([curriculumId, week])
  @@map("curriculum_plan_weeks")
}

// ==========================================
// 15. Honor Roll System (لوحة الشرف المدرسي)
// ==========================================

enum HonorKind {
  TEACHER
  STUDENT
}

model HonorRoll {
  id           String    @id @default(cuid())
  kind         HonorKind // TEACHER أو STUDENT
  name         String    // الاسم العربي الكامل
  photoUrl     String?   // رابط الصورة الشخصية (اختياري)
  
  // معرّفات الربط بالكيان الأصلي (اختياري للسماح بالإضافة اليدوية أيضاً)
  teacherId    String?
  studentId    String?

  // خاص بالمعلم: مصفوفة المواد التي يدرسها (تدعم مادة واحدة أو عدة مواد)
  subjects     String[]  @default([])
  
  // خاص بالطالب: الفصل الدراسي (مثال: "3/1" أو "1/2")
  section      String?
  
  // سبب التكريم أو الإنجاز (مثال: "المعلم المثالي على مستوى الإدارة" / "الأول على الصف الثالث")
  achievement  String?
  
  // التوثيق الأكاديمي
  academicYear String?   @default("2026/2027")
  term         String?   @default("الفصل الدراسي الأول")
  order        Int       @default(0) // لترتيب ظهور الكروت
  isActive     Boolean   @default(true)

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  teacher      Teacher?  @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  student      Student?  @relation(fields: [studentId], references: [id], onDelete: SetNull)

  @@index([kind])
  @@index([isActive])
  @@map("honor_roll")
}

// ==========================================
// 16. Home Content (محتوى الصفحة الرئيسية)
// ==========================================

model HomePrincipal {
  id          String   @id @default(cuid())
  key         String   @unique @default("principal_word") // معرف نوع المحتوى
  name        String   // اسم المدير (مثال: أ. عبدالله أحمد علي)
  title       String   @default("مدير المدرسة") // المسمى الوظيفي
  photoUrl    String?  @db.Text // رابط الصورة أو Base64 data URL
  message     String[] // مصفوفة فقرات الكلمة (PostgreSQL text array)
  updatedBy   String?  // كود أو ID الأدمن الذي أجرى التعديل
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@map("home_principal_word")
}

model HomeGallerySlide {
  id        String   @id @default(cuid())
  title     String   // عنوان النشاط (مثال: الأنشطة الطلابية)
  caption   String?  // وصف النشاط (مثال: طلابنا في أنشطة متنوعة تنمّي مواهبهم وروح الفريق)
  src       String   @db.Text // رابط الصورة أو Base64 data URL
  order     Int      @default(0) // ترتيب العرض في الكاروسيل (تصاعدياً)
  hidden    Boolean  @default(false) // مخفية أو معروضة للزوار
  createdBy String?  // معرف الأدمن الذي أضاف الصورة
  updatedBy String?  // معرف الأدمن الذي أجرى آخر تعديل
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([order])
  @@index([hidden])
  @@map("home_gallery_slides")
}



// ==========================================
// 17. Assignments (الواجبات والتكليفات المدرسية)
// ==========================================
// A teacher publishes an assignment to their classes (one row per class) with optional files;
// the students of that class see it and download the files.

model Assignment {
  id          String   @id @default(cuid())
  teacherId   String
  classId     String
  // Arabic subject name, as in Teacher.teachingSubjects (e.g. "الرياضيات")
  subject     String
  title       String
  description String   @default("")
  dueDate     DateTime
  maxScore    Float    @default(10)
  // false = solved outside the platform (e.g. in the notebook): students can't hand it in here
  requiresSubmission Boolean @default(true)
  publishedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  teacher     Teacher                @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  class       Class                  @relation(fields: [classId], references: [id], onDelete: Cascade)
  attachments AssignmentAttachment[]
  submissions AssignmentSubmission[]

  @@index([teacherId, publishedAt])
  @@index([classId, publishedAt])
  @@index([publishedAt])
  @@map("assignments")
}

model AssignmentAttachment {
  id           String   @id @default(cuid())
  assignmentId String
  fileName     String
  fileSize     Int
  fileType     String?
  // Where the file is kept, relative to the uploads folder.
  // An assignment published to several classes shares one stored file between its rows.
  fileKey      String
  uploadedAt   DateTime @default(now())

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@index([assignmentId, uploadedAt])
  @@index([fileKey])
  @@map("assignment_attachments")
}

// A student's answer to an assignment and the teacher's marking. Handing in again replaces it.
// Not linked to the gradebook (grades): that one stays filled by hand and from Excel.
model AssignmentSubmission {
  id           String    @id @default(cuid())
  assignmentId String
  studentId    String
  note         String    @default("")
  submittedAt  DateTime  @default(now())
  // null until the teacher marks it
  score        Float?
  feedback     String    @default("")
  gradedAt     DateTime?
  updatedAt    DateTime  @updatedAt

  assignment Assignment               @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student    Student                  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  files      AssignmentSubmissionFile[]

  @@unique([assignmentId, studentId])
  @@index([assignmentId, submittedAt])
  @@index([studentId])
  @@map("assignment_submissions")
}

model AssignmentSubmissionFile {
  id           String   @id @default(cuid())
  submissionId String
  fileName     String
  fileSize     Int
  fileType     String?
  // Where the file is kept, relative to the uploads folder
  fileKey      String
  uploadedAt   DateTime @default(now())

  submission AssignmentSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId, uploadedAt])
  @@map("assignment_submission_files")
}
